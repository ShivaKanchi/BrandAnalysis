# ==============================================================================
# Git Ignore for BrandAnalysis
# Ensures secrets, virtualenvs, browser session cookies, and build caches stay private
# ==============================================================================

# --- Secrets & Environment Configurations ---
.env
.env.*
!.env.example
*.key
*.pem
*.cert
secrets/

# --- Virtual Environments ---
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# --- Python Bytecode & Packaging ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- Testing, Coverage & Type Checking ---
.pytest_cache/
.coverage
.coverage.*
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# --- Playwright & Headless Browser Caches ---
playwright/.cache/
test-results/
cookies.json
*cookie*.json
*.session
browser_state.json

# --- Editor & OS Junk ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# --- Logs & Scratch Folders ---
*.log
logs/
scratch/
tmp/
temp/

# --- Temporary / In-flight report files (Preserve demo samples) ---
reports/**/*.tmp
reports/**/temp_*

# --- Saved Reports (Uncomment if needed to track reports) ---
reports/*